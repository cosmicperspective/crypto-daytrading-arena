# Kafka broker address (required by all components)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LLM provider API key (required by deploy_chat_node.py)
OPENAI_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=your-api-key-here
GEMINI_API_KEY=your-api-key-here
DEEPSEEK_API_KEY=your-api-key-here
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Simulation preset: paper | realistic | ultra
SIM_PRESET=paper

# Persistence (SQLite)
SIM_DB_PATH=arena.db

# Optional simulation overrides
# SIM_TAKER_FEE_BPS=6
# SIM_MAKER_FEE_BPS=4
# SIM_SLIPPAGE_BPS=5
# SIM_IMPACT_BPS=15
# SIM_LATENCY_MS=250
# SIM_PARTIAL_FILL_PROB=0.2
# SIM_PARTIAL_MIN_RATIO=0.4
# SIM_PARTIAL_MAX_RATIO=0.9
# SIM_MIN_TRADE_INTERVAL_S=2
# SIM_MAX_ORDER_USD=25000
# SIM_MAX_POSITION_USD=75000
# SIM_MAX_LEVERAGE=1.5
# SIM_ALLOW_NEGATIVE_CASH=true
# SIM_FUNDING_BPS_PER_HOUR=0
# SIM_BORROW_BPS_PER_HOUR=0
